<ui:composition xmlns="http://www.w3.org/1999/xhtml"
	xmlns:h="http://java.sun.com/jsf/html"
	xmlns:f="http://java.sun.com/jsf/core"
	xmlns:ui="http://java.sun.com/jsf/facelets"
	xmlns:c="http://java.sun.com/jsp/jstl/core"
	xmlns:p="http://primefaces.org/ui">
	<p:dialog modal="true" widgetVar="dialog_30_1" id="dialog_30_1"
		closeOnEscape="true" hideEffect="drop" showHeader="true"
		appendTo="@(body)" resizable="true" responsive="true">
		<f:facet name="header">
			<h:outputText value="Categoría Faltante " />
			<p:outputLabel value="par_030_1.xhtml"
				rendered="#{appMain.usuario.idUsuario eq 1}"></p:outputLabel>
		</f:facet>
		<h:form id="frm_par_030_1">
			<div align="right">
				<p:commandButton title="Guardar" icon="pi pi-save"
					action="#{CategoriaFaltanteBn.guardar()}"
					update=":frm_par_030,:frm_par_030:msg"
					oncomplete="PF('dialog_30_1').hide()" />
			</div>
			<p:panelGrid columns="2" styleClass="fullsize sinborde">
				<p:outputLabel value="Código " />
				<p:outputLabel
					value="#{CategoriaFaltanteBn.catFaltanteSeleccionado.codigo}"></p:outputLabel>
				<p:outputLabel value="Tipo" />
				<p:selectOneMenu
					value="#{CategoriaFaltanteBn.tipoInventarioSeleccionado}"
					converter="#{tipoInventarioConverter}">
					<f:selectItem itemLabel="Tipo Inventario" />
					<f:selectItems value="#{CategoriaFaltanteBn.tipoInventarioList}"
						var="tipoInv" itemValue="#{tipoInv}"
						itemLabel="#{tipoInv.descripcion}" />
				</p:selectOneMenu>
				<p:outputLabel value="Categoría" />
				<p:inputText
					value="#{CategoriaFaltanteBn.catFaltanteSeleccionado.descripcion}"
					required="true" requiredMessage="Valor de Nombre es requerido"
					styleClass="w75"></p:inputText>
				<p:outputLabel value="Top" />
				<p:selectBooleanCheckbox
					value="#{CategoriaFaltanteBn.catFaltanteSeleccionado.top}"></p:selectBooleanCheckbox>
				<h:panelGroup>
					<p:selectOneRadio id="oneCondicion" layout="responsive" columns="1"
						required="true" requiredMessage="Seleccione S-Suma o R-Resta"
						value="#{TipoMovimientoInventarioBn.condicionSeleccionada}">
						<f:selectItems value="#{TipoMovimientoInventarioBn.condiciones}"
							var="condicion" itemLabel="#{condicion}" itemValue="#{condicion}" />
					</p:selectOneRadio>
				</h:panelGroup>
				<p:outputLabel> Estado </p:outputLabel>
				<p:selectOneMenu editable="false"
					value="#{CategoriaFaltanteBn.catFaltanteSeleccionado.estado}">
					<f:selectItems value="#{CategoriaFaltanteBn.estadosActIna}" />
				</p:selectOneMenu>
			</p:panelGrid>
		</h:form>
	</p:dialog>
</ui:composition>