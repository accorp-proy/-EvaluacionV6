	public void inicializarObj() {

	}

	public void redireccionar() {
		String pagina = "";
		try {
			UsuarioEt usuario = appMain.getUsuario();
			List<FaltanteInventarioEt> faltantesInvEjecutando = iFaltanteInvDao.getFaltanteInveEjecutando(usuario);
			if (faltantesInvEjecutando != null && !faltantesInvEjecutando.isEmpty()) {
				for (FaltanteInventarioEt faltantesInvC : faltantesInvEjecutando) {
					faltantesInvC.setEjecutando(false);
					iFaltanteInvDao.guardarFaltanteInv(faltantesInvC, usuario);
				}
			}
			if (faltanteInvSeleccionado != null) {
				faltanteInvSeleccionado.setEjecutando(true);
				FacesContext contex = FacesContext.getCurrentInstance();
				pagina = "/PrimaxEvaluacionPruebas/pages/planificacion/pln_018.xhtml";
				faltanteInvSeleccionado.setEstadoCheckList(EstadoCheckListEnum.EN_EJECUCION);
				iFaltanteInvDao.guardarFaltanteInv(faltanteInvSeleccionado, usuario);
				contex.getExternalContext().redirect(pagina);
			}
		} catch (

		Exception e) {
			e.printStackTrace();
			System.out.println("Error :Método redireccionar " + " " + e.getMessage());
		}
	}

	public void guardar() {
		try {
			redireccionar();
		} catch (Exception e) {
			e.printStackTrace();
			System.out.println("Error :Método guardar " + " " + e.getMessage());
		}

	}

	public void buscar() {
		try {
			UsuarioEt usuario = appMain.getUsuario();
			ResponsableEt responsable = iResponsableDao.getResponsableEstacion(usuario.getPersonaUsuario());
			faltantesInventario = iFaltanteInvDao.getCheckListPlanAccion(responsable.getAgencia());
		} catch (Exception e) {
			e.printStackTrace();
			System.out.println("Error :Método buscar " + " " + e.getMessage());
		}
	}

	@Override
	protected void onDestroy() {
		iUsuarioDao.remove();
		iAgenciaDao.remove();
		iEvaluacionDao.remove();
		iResponsableDao.remove();
		iTipoChecListDao.remove();
		iPlanificacionDao.remove();
		iCheckListEjecucionDao.remove();
		iPlanAccionInventarioDao.remove();
		iCheckListEjecucionFirmaDao.remove();
		iPlanificacionInventarioDao.remove();
		iPlanAccionInventarioTipoDao.remove();
		iPlanificacionInventarioTipoDao.remove();
	}

}
