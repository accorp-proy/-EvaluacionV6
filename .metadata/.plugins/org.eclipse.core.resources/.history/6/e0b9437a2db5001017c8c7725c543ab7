<ui:composition xmlns="http://www.w3.org/1999/xhtml"
	xmlns:h="http://java.sun.com/jsf/html"
	xmlns:f="http://java.sun.com/jsf/core"
	xmlns:ui="http://java.sun.com/jsf/facelets"
	xmlns:p="http://primefaces.org/ui" template="/WEB-INF/template.xhtml">
	<ui:define name="title">Dashboard</ui:define>
	<style type="text/css">
.main-content {
	padding: 0;
}
</style>
	<ui:define name="content">
	</ui:define>
	<ui:define name="content">
		<h:form id="frm_ger_005">
			<div align="center">
				<p:dataTable paginator="true" rows="9" reflow="true"
					tableStyle="table-layout: auto;" style="margin-bottom:20px"
					emptyMessage="No existe Formatos" id="dtbCheckList"
					value="#{ConsultaPlanAccionFBn.faltantesInventario}"
					var="falInv">
					<p:column headerText="Código">
						<h:outputText value="#{falInv.checkListEjecucion.codigo}"></h:outputText>
					</p:column>
					<p:column headerText="Fecha Ejecución">
						<h:outputText value="#{falInv.checkListEjecucion.fechaRegistro}">
							<f:convertDateTime pattern="dd-MM-yyyy" />
						</h:outputText>
					</p:column>
					<p:column headerText="Evaluación">
						<h:outputText value="#{falInv.checkListEjecucion.evaluacion.descripcion}"></h:outputText>
					</p:column>
					<p:column headerText="Tipo CheckList">
						<h:outputText value="#{falInv.checkListEjecucion.tipoChecKList.descripcion}"></h:outputText>
					</p:column>

					<p:column headerText="Estado CheckList">
						<h:outputText value="#{falInv.checkListEjecucion.estadoCheckList.descripcion}"
							title="El estado en que se encuetra el CheckList"></h:outputText>
					</p:column>
					<p:column headerText="Plan Acción">
						<h:outputText value="#{falInv.estadoPlanAccion.descripcion}"
							title="El estado en que se encuetra el Plan de acción"></h:outputText>
					</p:column>
					<p:column width="5" headerText="Acción">
						<div align="center">
							<p:commandButton icon="ui-icon-event-available"
								disabled="#{falInv.estadoPlanAccion.descripcion ne 'PENDIENTE'}"
								title="Botón permite ingresar plan Acción"
								onclick="PF('dlg_conf_0').show()" process="@this frm_ger_005"
								action="#{ConsultaPlanAccionFBn.modificar(falInv)}"></p:commandButton>
						</div>
					</p:column>
				</p:dataTable>
			</div>
		</h:form>
		<p:confirmDialog widgetVar="dlg_conf_0" header="Confirmar"
			appendTo="@(body)" message="Esta seguro de ingresar Plan de Acción ?"
			severity="alert" closeOnEscape="true" showEffect="fade"
			hideEffect="fade">
			<div align="center">
				<p:commandButton styleClass="ui-confirmdialog-no"
					icon="ui-icon-close" value="Cancelar" immediate="true"
					oncomplete="PF('dlg_conf_0').hide()"></p:commandButton>
				<p:commandButton value="Aceptar" styleClass="ui-confirmdialog-yes"
					immediate="true" icon="ui-icon-check"
					oncomplete="PF('dlg_conf_0').hide()"
					update="frm_ger_005:dtbCheckList"
					action="#{ConsultaPlanAccionFBn.guardar()}" process="@this"></p:commandButton>
			</div>
		</p:confirmDialog>
	</ui:define>
</ui:composition>