package com.primax.srv.dao;

import java.util.Date;
import java.util.concurrent.TimeUnit;

import javax.annotation.PreDestroy;
import javax.ejb.Remove;
import javax.ejb.Stateful;
import javax.ejb.StatefulTimeout;
import javax.ejb.TransactionAttribute;
import javax.ejb.TransactionAttributeType;
import javax.persistence.StoredProcedureQuery;
import javax.persistence.TemporalType;

import com.primax.enm.gen.ActionAuditedEnum;
import com.primax.exc.gen.EntidadNoGrabadaException;
import com.primax.jpa.param.CategoriaFaltanteEt;
import com.primax.jpa.pla.ReporteSeleccionEt;
import com.primax.jpa.sec.UsuarioEt;
import com.primax.srv.dao.base.GenericDao;
import com.primax.srv.idao.IReporteFaltanteInventarioDao;
import com.primax.srv.idao.IReporteSeleccionDao;

@Stateful
@StatefulTimeout(unit = TimeUnit.HOURS, value = 8)
public class ReporteSeleccionDao extends GenericDao<ReporteSeleccionEt, Long> implements IReporteSeleccionDao {

	public ReporteSeleccionDao() {
		super(ReporteSeleccionEt.class);
	}

	@Override
	@TransactionAttribute(TransactionAttributeType.REQUIRES_NEW)
	public void guardaReporteS(ReporteSeleccionEt rptSeleccion, UsuarioEt usuario) throws EntidadNoGrabadaException {
		if (rptSeleccion.getIdReporteSeleccion() == null) {
			rptSeleccion.audit(usuario, ActionAuditedEnum.NEW);
			crear(rptSeleccion);
		} else {
			rptSeleccion.audit(usuario, ActionAuditedEnum.UPD);
			actualizar(rptSeleccion);
		}
		em.flush();
		em.clear();
	}


	@Remove
	@TransactionAttribute(TransactionAttributeType.NOT_SUPPORTED)
	public void remove() {
		System.out.println("Finalizado Statefull Bean : " + this.getClass().getCanonicalName());
	}

	@PreDestroy
	@TransactionAttribute(TransactionAttributeType.NOT_SUPPORTED)
	public void detached() {
		System.out.println("Terminado Statefull Bean : " + this.getClass().getCanonicalName());
	}

}
