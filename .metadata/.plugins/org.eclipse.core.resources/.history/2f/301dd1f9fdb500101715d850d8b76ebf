<ui:composition xmlns="http://www.w3.org/1999/xhtml"
	xmlns:h="http://java.sun.com/jsf/html"
	xmlns:f="http://java.sun.com/jsf/core"
	xmlns:ui="http://java.sun.com/jsf/facelets"
	xmlns:c="http://java.sun.com/jsp/jstl/core"
	xmlns:p="http://primefaces.org/ui" template="/WEB-INF/template.xhtml">
	<ui:define name="title">Plan de Acción Criterio General</ui:define>
	<ui:define name="content">
		<h:form id="frm_pln_017">
			<p:growl showDetail="false" id="msg">
			</p:growl>
			<p:panelGrid>
				<p:row>
					<p:column>
						<p:commandButton action="#{InvFaltanteEjecucionBn.retroceder()}"
							icon="pi pi-arrow-circle-left" title="Botón permite retroceder"></p:commandButton>
					</p:column>
					<p:column>
						<p:outputLabel value="Fecha Control:"></p:outputLabel>
						<p:spacer width="5"></p:spacer>
						<p:outputLabel
							value="#{InvFaltanteEjecucionBn.faltanteInvSelecc.checkListEjecucion.planificacion.fechaPlanificacion}">
							<f:convertDateTime pattern="dd-MM-yyyy" />
						</p:outputLabel>
					</p:column>
					<p:column>
						<p:outputLabel value="Estación:"></p:outputLabel>
						<p:spacer width="5"></p:spacer>
						<p:outputLabel
							value="#{InvFaltanteEjecucionBn.faltanteInvSelecc.checkListEjecucion.planificacion.agencia.nombreAgencia}"></p:outputLabel>
					</p:column>
					<p:column>
						<p:outputLabel value="Nivel Riesgo:"></p:outputLabel>
						<p:spacer width="5"></p:spacer>
						<p:outputLabel
							value="#{InvFaltanteEjecucionBn.faltanteInvSelecc.checkListEjecucion.nivelRiesgoS}"></p:outputLabel>
					</p:column>
					<p:column>
						<h:graphicImage value="/resources/images/iconos/4.png"
							rendered="#{InvFaltanteEjecucionBn.faltanteInvSelecc.checkListEjecucion.nivelRiesgo == 4}"
							title="Nivel de Riego Bajo" styleClass="ui-icon ui-icon-check"
							style="display: block; margin: 0px auto;" />
						<h:graphicImage value="/resources/images/iconos/3.png"
							rendered="#{InvFaltanteEjecucionBn.faltanteInvSelecc.checkListEjecucion.nivelRiesgo == 3}"
							title="Nivel de Riego Medio" styleClass="ui-icon ui-icon-check"
							style="display: block; margin: 0px auto;" />
						<h:graphicImage value="/resources/images/iconos/1.png"
							rendered="#{InvFaltanteEjecucionBn.faltanteInvSelecc.checkListEjecucion.nivelRiesgo == 1}"
							title="Nivel de Riego Crítico" styleClass="ui-icon ui-icon-check"
							style="display: block; margin: 0px auto;" />
					</p:column>
					<p:column>
						<p:commandButton title="Descargar CheckList en formato Excel"
							icon="pi pi-file-excel" immediate="true" ajax="false"
							actionListener="#{ReporteBn.imprimirExcel(6,appMain.usuario.nombreUsuario,InvFaltanteEjecucionBn.faltanteInvSelecc.checkListEjecucion.idCheckListEjecucion.toString(),InvFaltanteEjecucionBn.faltanteInvSelecc.checkListEjecucion.tipoChecKList.descripcion,InvFaltanteEjecucionBn.faltanteInvSelecc.checkListEjecucion.codigo,null,null,null,null,null,null,true)}">
							<p:fileDownload value="#{appMain.download}"></p:fileDownload>
						</p:commandButton>
					</p:column>
					<p:column>
						<p:commandButton icon="pi pi-pencil" title="Editar"
							oncomplete="PF('dlg_pln_018').show()" update=":frm_pln_018"></p:commandButton>
					</p:column>
					<p:column>
						<div align="left">
							<p:commandButton id="btnGuardar" icon="pi pi-save"
								title="Guardar Plan Acción" onclick="PF('dlg_conf_0').show()"></p:commandButton>
						</div>
					</p:column>
				</p:row>
			</p:panelGrid>
			<p:panelGrid columns="2" styleClass="fullsize sinborde"
				style="width:100%">
				<p:dataTable id="dtbTopN" var="topN" scrollable="true"
					scrollHeight="300"
					value="#{InvFaltanteEjecucionBn.faltanteInvSelecc.faltanteTopNegativo}"
					emptyMessage="No existen Procesos">
					<f:facet name="header">
						<div align="center">
							<h:outputLabel value="Top Consolidado Negativo" />
						</div>
					</f:facet>
					<p:column headerText="Producto ">
						<h:outputText value="#{topN.nombreProducto}"></h:outputText>
					</p:column>
					<p:column headerText="Categoría ">
						<h:outputText value="#{topN.categoriaFaltante.descripcion}"></h:outputText>
					</p:column>
					<p:column headerText="Cantidad Diferencia">
						<h:outputText value="#{topN.cantidad}">
							<f:convertNumber pattern="##0.00" />
						</h:outputText>
					</p:column>
					<p:column headerText="Variación Costo  ">
						<h:outputText value="#{topN.variacion}">
							<f:convertNumber pattern="##0.00" />
						</h:outputText>
					</p:column>
					<p:columnGroup type="footer">
						<p:row>
							<p:column style="text-align:left" footerText="Total:" />
							<p:column>
								<f:facet name="footer">
									<h:outputText value="#{InvFaltanteEjecucionBn.totCantNS}" />
								</f:facet>
							</p:column>
							<p:column>
								<f:facet name="footer">
									<h:outputText value="#{InvFaltanteEjecucionBn.totVarNS}" />
								</f:facet>
							</p:column>
						</p:row>
					</p:columnGroup>
				</p:dataTable>
				<p:dataTable id="dtbTopP" var="topP" scrollable="true"
					scrollHeight="300"
					value="#{InvFaltanteEjecucionBn.faltanteInvSelecc.faltanteTopPositivo}"
					emptyMessage="No existen Procesos">
					<f:facet name="header">
						<div align="center">
							<h:outputLabel value="Top Consolidado Positivo" />
						</div>
					</f:facet>
					<p:column headerText="Producto ">
						<h:outputText value="#{topP.nombreProducto}"></h:outputText>
					</p:column>
					<p:column headerText="Categoría ">
						<h:outputText value="#{topP.categoriaFaltante.descripcion}"></h:outputText>
					</p:column>
					<p:column headerText="Cantidad Diferencia">
						<h:outputText value="#{topP.cantidad}">
							<f:convertNumber pattern="##0.00" />
						</h:outputText>
					</p:column>
					<p:column headerText="Variación Costo  ">
						<h:outputText value="#{topP.variacion}">
							<f:convertNumber pattern="##0.00" />
						</h:outputText>
					</p:column>
					<p:column headerText="Comentario Control">
					<div align="left">
						<p:inputTextarea id="inpTextArea0"
							value="#{topP.comentarioControl}" rows="4" styleClass="w100"
							maxlength="500">
							<p:ajax event="change" process="@this dtbTopP"
								listener="#{InvFaltanteEjecucionBn.guardarDet()}" />
						</p:inputTextarea>
					</div>
				</p:column>
					<p:columnGroup type="footer">
						<p:row>
							<p:column style="text-align:left" footerText="Total:" />
							<p:column>
								<f:facet name="footer">
									<h:outputText value="#{InvFaltanteEjecucionBn.totCantPS}" />
								</f:facet>
							</p:column>
							<p:column>
								<f:facet name="footer">
									<h:outputText value="#{InvFaltanteEjecucionBn.totVarPS}" />
								</f:facet>
							</p:column>
						</p:row>
					</p:columnGroup>
				</p:dataTable>

			</p:panelGrid>


			<p:dataTable id="dtbFaltanteR" var="resumen" scrollable="true"
				scrollHeight="300"
				value="#{InvFaltanteEjecucionBn.faltanteInvSelecc.faltanteResumen}"
				emptyMessage="No existen Procesos">
				<f:facet name="header">
                      #{InvFaltanteEjecucionBn.faltanteInvSelecc.checkListEjecucion.evaluacion.descripcion} - #{InvFaltanteEjecucionBn.faltanteInvSelecc.checkListEjecucion.tipoChecKList.descripcion} - #{InvFaltanteEjecucionBn.faltanteInvSelecc.checkListEjecucion.codigo}
                         </f:facet>
				<p:column headerText="Categoría ">
					<h:outputText value="#{resumen.descripcion}"></h:outputText>
				</p:column>
				<p:column headerText="Cantidad Diferencia">
					<h:outputText value="#{resumen.cantidad}">
						<f:convertNumber pattern="##0.00" />
					</h:outputText>
				</p:column>
				<p:column headerText="Variación Costo  ">
					<h:outputText value="#{resumen.variacion}">
						<f:convertNumber pattern="##0.00" />
					</h:outputText>
				</p:column>
				<p:column headerText="Ver">
					<p:commandButton icon="pi pi-eye" process="@this dtbFaltanteR"
						update="frm_pln_017:dtbFaltanteD"
						action="#{InvFaltanteEjecucionBn.verDetalle(resumen)}">
					</p:commandButton>
				</p:column>
				<p:column headerText="Comentario Control">
					<div align="left">
						<p:inputTextarea id="inpTextArea0"
							value="#{resumen.comentarioControl}" rows="4" styleClass="w100"
							maxlength="500">
							<p:ajax event="change" process="@this dtbFaltanteR"
								listener="#{InvFaltanteEjecucionBn.guardarDet()}" />
						</p:inputTextarea>
					</div>
				</p:column>
				<p:columnGroup type="footer">
					<p:row>
						<p:column style="font-weight:bold" footerText="Total:" />
						<p:column style="font-weight:bold"
							footerText="#{InvFaltanteEjecucionBn.totCantidadS}" />
						<p:column style="font-weight:bold"
							footerText="#{InvFaltanteEjecucionBn.totVariacionS}" />
					</p:row>
				</p:columnGroup>
			</p:dataTable>
			<p:dataTable var="detalle"
				value="#{InvFaltanteEjecucionBn.faltanteDet}" reflow="true"
				id="dtbFaltanteD" emptyMessage="No existe información">
				<f:facet name="header">
                          DETALLE CONTEO DE PRODUCTOS
                    </f:facet>
				<p:column headerText="Nombres">
					<p:outputLabel value="#{detalle.nombreProducto}" />
				</p:column>
				<p:column headerText="Cantidad teórica">
					<p:outputLabel value="#{detalle.cantidadTeorica}">
						<f:convertNumber pattern="##0.00" />
					</p:outputLabel>
				</p:column>
				<p:column headerText="Cantidad contada">
					<p:outputLabel value="#{detalle.cantidadContada}">
						<f:convertNumber pattern="##0.00" />
					</p:outputLabel>
				</p:column>
				<p:column headerText="Cantidad diferencia">
					<p:outputLabel value="#{detalle.cantidadDiferencia}">
						<f:convertNumber pattern="##0.00" />
					</p:outputLabel>
				</p:column>
				<p:column headerText="Costo Unitario">
					<p:outputLabel value="#{detalle.costoUnitario}">
						<f:convertNumber pattern="##0.00" />
					</p:outputLabel>
				</p:column>
				<p:column headerText="Variación Costo">
					<p:outputLabel value="#{detalle.costoVariacion}">
						<f:convertNumber pattern="##0.00" />
					</p:outputLabel>
				</p:column>
			</p:dataTable>

		</h:form>
		<ui:include src="/pages/planificacion/pln_018.xhtml"></ui:include>
		<p:confirmDialog widgetVar="dlg_conf_0" header="Confirmar"
			appendTo="@(body)"
			message="Esta seguro de guardar Inventario Faltante ?"
			severity="alert" closeOnEscape="true" showEffect="fade"
			hideEffect="fade">
			<div align="center">
				<p:commandButton styleClass="ui-confirmdialog-no"
					icon="ui-icon-close" value="Cancelar" immediate="true"
					oncomplete="PF('dlg_conf_0').hide()"></p:commandButton>
				<p:commandButton value="Aceptar" styleClass="ui-confirmdialog-yes"
					immediate="true" icon="ui-icon-check"
					oncomplete="PF('dlg_conf_0').hide()" update="frm_pln_017"
					action="#{InvFaltanteEjecucionBn.guardar()}" process="@this"></p:commandButton>
			</div>
		</p:confirmDialog>
	</ui:define>
</ui:composition>