	<queryString>
		<![CDATA[select
eje.codigo as codigo,
pla.fecha_planificacion as fechaPlanificacion,
est.nombre_agencia as estacion,
eje.descripcion chek,
res.descripcion as categoria,
res.cantidad as cantidad ,
res.comentario_plan_accion as comentario,
eje.calificacion,
eje.nivel_riesgo as nivel,
eje.nivel_riesgo_s
from faltante_inventario_et inv
inner join check_list_ejecucion_et eje
on inv.id_check_list_ejecucion = eje.id_check_list_ejecucion
inner join planificacion_et pla
on eje.id_planificacion = pla.id_planificacion
inner join agencia_et est
on pla.id_agencia=est.id_agencia
inner join faltante_resumen_et res
on inv.id_faltante_inventario = res.id_faltante_inventario
and res.comentario_plan_accion != ''
where eje.id_check_list_ejecucion = $P{par_id_check_list_ejecucion}]]>
	</queryString>
